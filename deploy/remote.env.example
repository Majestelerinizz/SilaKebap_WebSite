# Production .env for Contabo + CloudPanel
# Place on server as /opt/silakebap/.env (never commit secrets).

NODE_ENV=production
API_PORT=14100
# Do NOT set PORT here — web/admin share this file; systemd units set PORT=13100 / 13101

DATABASE_URL=postgresql://silakebap:CHANGE_ME@127.0.0.1:5432/silakebap

JWT_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS_LONG
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS

WEB_ORIGIN=https://62.171.146.132.nip.io
ADMIN_ORIGIN=https://admin.62.171.146.132.nip.io
API_PUBLIC_URL=https://62.171.146.132.nip.io
NEXT_PUBLIC_API_URL=https://62.171.146.132.nip.io
PENDING_PAYMENT_TTL_MINUTES=30

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sıla Kebap <noreply@example.com>"

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=silakebap
R2_PUBLIC_URL=
